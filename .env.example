# ==============================================================================
# HisabAI Environment Configuration Example
# Copy this file to .env and configure values for your local environment.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME=HisabAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/hisabai_db
DB_ECHO=false

# Document Upload & Storage Settings
# Upload directory must remain outside public static access
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp

# OCR Provider Settings
# Supported: 'mock', 'google_vision'
OCR_PROVIDER=mock
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# LLM Fallback Settings (Disabled by default)
LLM_FALLBACK_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Background Job & Cache Settings
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
